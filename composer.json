{
    "name": "visnsstudio/visns-packages",
    "description": "Laravel/PHP packages used for Omnia Global Projects",
    "version": "3.5.8.18",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Visnsstudio\\VisnsPackages\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Omnia Global",
            "email": "team@omniaglobal.com.au"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2|^8.3",
        "laravel/framework": ">=11.0",
        "bacon/bacon-qr-code": "^3.0",
        "pragmarx/google2fa": "^8.0",
        "phpoffice/phpspreadsheet": "^1.29",
        "mpdf/mpdf": "^8.2"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Visnsstudio\\VisnsPackages\\VisnsPackagesServiceProvider"
            ]
        }
    }
