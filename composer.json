{
    "name": "visnsstudio/visns-packages",
    "description": "Laravel/PHP packages used for Omnia Global Projects",
    "type": "library",
    "license": "MIT",
    "version": "4.3.0",
    "autoload": {
        "psr-4": {
            "Visnsstudio\\VisnsPackages\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Omnia Global",
            "email": "team@omniaglobal.com.au"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2|^8.3",
        "laravel/framework": ">=11.0",
        "bacon/bacon-qr-code": "^3.0",
        "pragmarx/google2fa": "^8.0",
        "phpoffice/phpspreadsheet": "^1.29",
        "barryvdh/laravel-dompdf": "^3.0",
        "tecnickcom/tcpdf": "^6.7",
        "spatie/laravel-pdf": "^1.6",
        "spatie/browsershot": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^9.0",
        "laravel/sanctum": "^4.0",
        "spatie/laravel-permission": "^6.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Visnsstudio\\VisnsPackages\\Tests\\": "tests/",
            "App\\": "tests/Fixtures/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Visnsstudio\\VisnsPackages\\VisnsPackagesServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --testsuite=Platform"
    }
}
